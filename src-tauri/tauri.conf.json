{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CTXBench Desktop",
  "version": "0.1.3",
  "identifier": "io.ctxbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:43173",
    "beforeBuildCommand": "npm run build && node scripts/stage-deployment.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CTXBench Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#080d13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:48173; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../.desktop-deployment/": "deployment/" },
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } }
  }
}
