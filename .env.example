# Copy only the variables your selected adapters require into .env.
# Values are passed to the worker at runtime and never baked into images.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENROUTER_API_KEY=
XIAOMI_TOKEN_PLAN_CN_API_KEY=
GITHUB_TOKEN=

# Comma-separated names for company-internal agent credentials.
# Add matching NAME=value entries below. Names, never values, are stored in run specs.
CTXBENCH_EXTRA_ENV_ALLOWLIST=
