{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxbench.io/schemas/agent-request.schema.json",
  "title": "Containerized agent request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "mode", "prompt", "model", "timeoutSeconds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string" },
    "mode": { "enum": ["solve", "generate-context", "grade", "mine-constraints", "judge-constraints"] },
    "prompt": { "type": "string" },
    "model": {
      "type": "object",
      "required": ["provider", "model", "thinking", "max_tokens"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "thinking": { "type": "string" },
        "max_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "contextPaths": { "type": "array", "items": { "type": "string" } },
    "envNames": { "type": "array", "items": { "type": "string" } },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "setupCommands", "steps"],
      "properties": {
        "version": { "const": 1 },
        "setupCommands": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1 } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 50, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "prompt"],
          "properties": { "name": { "type": "string" }, "prompt": { "type": "string", "minLength": 1 } }
        } }
      }
    },
    "metadata": { "type": "object" }
  }
}
