{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxbench.io/schemas/custom-task.schema.json",
  "title": "CTXBench custom task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repository", "baseCommit", "prompt", "test"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "prompt": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["image", "command"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 20000 } }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerfile"],
      "properties": {
        "dockerfile": { "type": "string" },
        "context": { "type": "string", "default": "." },
        "args": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["command"], "not": { "required": ["ci"] } }, { "required": ["ci"], "not": { "required": ["command"] } }],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "hiddenPatch": { "type": "string" },
        "ci": {
          "type": "object", "additionalProperties": false,
          "required": ["connectionId", "requiredJobs", "allowRemoteExecution"],
          "properties": {
            "connectionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "requiredJobs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
            "reportArtifact": { "type": "string", "maxLength": 200, "default": "" },
            "minTests": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1 },
            "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 30 },
            "allowRemoteExecution": { "const": true }
          }
        }
      }
    },
    "goldPatch": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "anyOf": [
    { "required": ["image"] },
    { "required": ["build"] }
  ],
  "if": { "properties": { "test": { "required": ["ci"] } } },
  "then": { "not": { "required": ["goldPatch"] }, "properties": { "test": { "not": { "required": ["hiddenPatch"] } } } }
}
